{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window: event listening plus the explicitly allow-listed app commands from build.rs.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-system-info",
    "allow-latest-snapshot",
    "allow-set-process-monitoring",
    "allow-terminate-process",
    "allow-history-settings",
    "allow-set-history-settings",
    "allow-query-history",
    "allow-history-status",
    "allow-clear-history"
  ]
}
